@model GYMProject.Models.SessionViewModel

@{
    ViewBag.Title = "Sessions";
}

<h2>Sessions</h2>

<div class="row">
    <div class="col-md-8">
        <h3>Session List</h3>
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Heure Debut</th>
                    <th>Heure Fin</th>
                    <th>Session Type</th>
                    <th>Coach</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Sessions)
                {
                    <tr>
                        <td>@item.HeureDebut</td>
                        <td>@item.HeureFin</td>
                        <td>@item.SessionType</td>
                        <td>@item.Staff.Nom @item.Staff.Prenom</td>
                        <td>
                            <button type="button" class="btn btn-primary btn-sm btn-load" data-id="@item.Id">Load</button>
                            <button type="button" class="btn btn-info btn-sm btn-details" data-id="@item.Id">Details</button>
                            <button type="button" class="btn btn-danger btn-sm btn-delete" data-id="@item.Id">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-4">
        <h3 id="formTitle">Create New Session</h3>
        @using (Html.BeginForm("Add", "Session", FormMethod.Post, new { id = "sessionForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" id="sessionId" name="Id" value="0" />

            <div class="form-group">
                <label for="heureDebut">Heure Debut</label>
                <input class="form-control" id="heureDebut" name="HeureDebut" />
            </div>
            <div class="form-group">
                <label for="heureFin">Heure Fin</label>
                <input class="form-control" id="heureFin" name="HeureFin" />
            </div>
            <div class="form-group">
                <label for="sessionType">Session Type</label>
                @Html.DropDownList("SessionType", Model.SessionTypes, "Select a session type", new { @class = "form-control", id = "sessionType" })
            </div>
            <div class="form-group">
                <label for="staffId">Coach</label>
                @Html.DropDownList("StaffId", Model.Coaches, "Select a coach", new { @class = "form-control", id = "staffId" })
            </div>
            <button type="submit" class="btn btn-success" id="btnSave">Create</button>
            <button type="button" class="btn btn-default" id="btnCancelEdit" style="display:none;">Cancel</button>
        }
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        function setCreateMode() {
            $('#sessionForm').attr('action', '@Url.Action("Add", "Session")');
            $('#sessionId').val(0);
            $('#heureDebut').val('');
            $('#heureFin').val('');
            $('#sessionType').val('');
            $('#staffId').val('');
            $('#formTitle').text('Create New Session');
            $('#btnSave').text('Create');
            $('#btnCancelEdit').hide();
        }

        $('#sessionForm').submit(function (event) {
            event.preventDefault();
            var $form = $(this);
            $.ajax({
                type: 'POST',
                url: $form.attr('action'),
                data: $form.serialize(),
                success: function (response) {
                    if (response.success) {
                        alert('Session saved successfully!');
                        location.reload();
                    } else {
                        alert('Error: ' + (response.errors || []).join(', '));
                    }
                },
                error: function () {
                    alert('An error occurred while saving the session.');
                }
            });
        });

        $('.btn-delete').click(function () {
            var id = $(this).data('id');
            if (!confirm('Are you sure you want to delete this session?')) {
                return;
            }

            $.ajax({
                type: 'POST',
                url: '@Url.Action("Delete", "Session")',
                data: { id: id },
                success: function (response) {
                    if (response.success) {
                        alert('Session deleted successfully!');
                        location.reload();
                    } else {
                        alert('Unable to delete session.');
                    }
                },
                error: function () {
                    alert('An error occurred while deleting the session.');
                }
            });
        });

        $('.btn-details').click(function () {
            var id = $(this).data('id');
            $.ajax({
                type: 'GET',
                url: '@Url.Action("Details", "Session")',
                data: { id: id },
                success: function (response) {
                    if (!response.success) {
                        alert(response.message || 'Session not found.');
                        return;
                    }

                    var session = response.session;
                    alert('Session #' + session.Id + '\nType: ' + session.SessionType + '\nHeure Debut: ' + session.HeureDebut + '\nHeure Fin: ' + session.HeureFin + '\nCoach ID: ' + session.StaffId);
                },
                error: function () {
                    alert('An error occurred while loading session details.');
                }
            });
        });

        $('.btn-load').click(function () {
            var id = $(this).data('id');
            $.ajax({
                type: 'GET',
                url: '@Url.Action("Details", "Session")',
                data: { id: id },
                success: function (response) {
                    if (!response.success) {
                        alert(response.message || 'Session not found.');
                        return;
                    }

                    var session = response.session;
                    $('#sessionForm').attr('action', '@Url.Action("Update", "Session")');
                    $('#sessionId').val(session.Id);
                    $('#heureDebut').val(session.HeureDebut);
                    $('#heureFin').val(session.HeureFin);
                    $('#sessionType').val(session.SessionType);
                    $('#staffId').val(session.StaffId);
                    $('#formTitle').text('Update Session');
                    $('#btnSave').text('Update');
                    $('#btnCancelEdit').show();
                },
                error: function () {
                    alert('An error occurred while loading the session for editing.');
                }
            });
        });

        $('#btnCancelEdit').click(function () {
            setCreateMode();
        });
    });
</script>
