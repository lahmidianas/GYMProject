@model IEnumerable<GYMProject.Models.Member>

@{
    ViewBag.Title = "Member Form";
}

<h2>Member Form</h2>

<div class="row">
    <div class="col-md-6">
        <h4>Members List</h4>
        <table class="table">
            <thead>
                <tr>
                    <th></th>
                    <th>Nom</th>
                    <th>Prenom</th>
                    <th>Phone</th>
                    <th>Membership Type</th>
                    <th>Start Membership Date</th>
                    <th>End Membership Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in Model)
                {
                    <tr>
                        <td>
                            <input type="checkbox" name="memberId" value="@member.Id" />
                        </td>
                        <td>@Html.DisplayFor(modelItem => member.Nom)</td>
                        <td>@Html.DisplayFor(modelItem => member.Prenom)</td>
                        <td>@Html.DisplayFor(modelItem => member.Phone)</td>
                        <td>@Html.DisplayFor(modelItem => member.MembershipType)</td>
                        <td>@Html.DisplayFor(modelItem => member.StartMembershipDate)</td>
                        <td>@Html.DisplayFor(modelItem => member.EndMembershipDate)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <h4>Member Details</h4>
        @using (Html.BeginForm("ProcessCommand", "Member", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="Id">Id</label>
                <input type="hidden" id="Id" name="Id" value="0" />
            </div>

            <div class="form-group">
                <label for="txtNom">Nom</label>
                <input class="form-control" placeholder="Nom" id="txtNom" name="Nom" />
            </div>

            <div class="form-group">
                <label for="txtPrenom">Prenom</label>
                <input class="form-control" placeholder="Prenom" id="txtPrenom" name="Prenom" />
            </div>

            <div class="form-group">
                <label for="txtPhone">Phone</label>
                <input class="form-control" placeholder="Phone" id="txtPhone" name="Phone" />
            </div>

            <div class="form-group">
                <label for="ddlMembershipType">Membership Type</label>
                @Html.DropDownList("MembershipType",
                                  new SelectList(new List<string>
                                  {
                                      "bodybuilding",
                                      "taekwondo",
                                      "boxing",
                                      "full-contact",
                                      "karate",
                                      "aerobic"
                                  }),
                                  "Select Membership Type",
                                  new { @class = "form-control", id = "ddlMembershipType" })
            </div>

            <div class="form-group">
                <label for="txtStartMembershipDate">Start Membership Date</label>
                <input class="form-control" type="date" id="txtStartMembershipDate" name="StartMembershipDate" />
            </div>

            <div class="form-group">
                <label for="txtEndMembershipDate">End Membership Date</label>
                <input class="form-control" type="date" id="txtEndMembershipDate" name="EndMembershipDate" />
            </div>

            <div class="form-group">
                <button type="submit" name="command" value="Add" class="btn btn-primary">Add</button>
                <button type="submit" name="command" value="Update" class="btn btn-primary">Update</button>
                <button type="submit" name="command" value="Delete" class="btn btn-danger">Delete</button>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(function () {
            $('input[type="checkbox"]').change(function () {
                if (this.checked) {
                    var memberId = $(this).val();
                    $.ajax({
                        url: '@Url.Action("GetMemberDetails", "Member")',
                        type: 'GET',
                        data: { id: memberId },
                        success: function (data) {
                            $('#Id').val(data.Id);
                            $('#txtNom').val(data.Nom);
                            $('#txtPrenom').val(data.Prenom);
                            $('#txtPhone').val(data.Phone);
                            $('#ddlMembershipType').val(data.MembershipType);
                            $('#txtStartMembershipDate').val((data.StartMembershipDate || '').substring(0, 10));
                            $('#txtEndMembershipDate').val((data.EndMembershipDate || '').substring(0, 10));
                        },
                        error: function () {
                            alert('Error retrieving member details.');
                        }
                    });
                }
            });
        });
    </script>
}
